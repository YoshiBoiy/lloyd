# /etc/lloyd-edge/gateway.env — root-owned, mode 0600, group lloyd-edge. Never commit a filled copy.
# Device credentials, reviewer credentials and the storage encryption key are distinct secrets (TDD §9).

EDGE_BIND_HOST=0.0.0.0
EDGE_BIND_PORT=8001
# Operator LAN allowed to pair and the backend host; must match nftables-egress.conf.
EDGE_LAN_CIDR=192.168.10.0/24
EDGE_BACKEND_IP=192.168.10.5

# Identity bound into every v2 manifest and checked by the backend policy.
EDGE_DEVICE_ID=rdk-x5-01
EDGE_TENANT_ID=tenant-a
EDGE_SIGNING_KEY_ID=rdk-x5-01-key-2026-09
# >=32 chars; device signing key. Must differ from every reviewer key.
EDGE_SIGNING_KEY=

# Local pairing token presented by the directly paired browser / app-server proxy.
EDGE_LOCAL_TOKEN=
# Browser origins allowed to pair directly (CORS). Comma separated, exact scheme://host:port.
EDGE_ALLOWED_ORIGINS=http://192.168.10.20:3000

# Reviewers: either a JSON file [{"token","id","key"}] or the single-reviewer shorthand below.
EDGE_REVIEWERS_FILE=/etc/lloyd-edge/reviewers.json
#EDGE_HUMAN_APPROVAL_TOKEN=
#EDGE_REVIEWER_ID=
#EDGE_REVIEWER_SIGNING_KEY=

# Release transport (the only permitted egress).
EDGE_BACKEND_URL=http://192.168.10.5:3001/api/intake/sanitized
EDGE_BACKEND_V2_URL=http://192.168.10.5:3001/api/intake/v2
API_TOKEN=

# Pinned local model artifacts from the installed bundle (bundle.manifest.json → models.*.env).
EDGE_CLASSIFIER_PATH=/opt/lloyd-edge/current/models/classifier.json
EDGE_CLASSIFIER_SHA256=
EDGE_DETECTOR_PATH=/opt/lloyd-edge/current/models/ner
EDGE_DETECTOR_SHA256=

# Capture and OCR.
EDGE_OCR=tesseract
EDGE_CAMERA_INDEX=0
EDGE_CAMERA_WARMUP_FRAMES=2
EDGE_HEALTH_PROBE_CAMERA=true

# Policy and retention.
EDGE_V2_ENABLED=false            # flip per device once §10 gates pass
EDGE_QUALITY_CALIBRATED=false    # provisional thresholds force REVIEW until calibrated
EDGE_APPROVAL_TTL_SECONDS=600
EDGE_CLOCK_TOLERANCE_SECONDS=30
EDGE_RETENTION_SECONDS=86400
EDGE_STORAGE_DIR=/var/lib/lloyd-edge

# Optional local page segmenter (distinct from EDGE_DETECTOR_* NER).
EDGE_PAGE_DETECTOR_PATH=/opt/lloyd-edge/current/models/page-v1_bayese_640x640_nv12.bin
EDGE_PAGE_DETECTOR_SHA256=
EDGE_PAGE_DETECTOR_BACKEND=auto
EDGE_PAGE_SCORE_MIN=0.35
EDGE_PAGE_INPUT=640

# Persistent local text detection + batched recognition (provision models first).
# EDGE_OCR=region
EDGE_OCR_MANIFEST=
EDGE_OCR_MANIFEST_SHA256=
EDGE_OCR_BATCH_SIZE=4
EDGE_OCR_THREADS=4
EDGE_OCR_DETECT_MAX_SIDE=960
