# No credentials required for the 56-case offline demo.
HOST=127.0.0.1
PORT=3001
# Required if binding API beyond loopback. Match API_TOKEN on the gateway.
API_TOKEN=
# Paired HMAC key required to accept authenticated low-confidence approvals.
RELEASE_APPROVAL_KEY=

FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=
# JSON mapping matching the discovered schema hash; see README.
FEDERATO_MAPPING_FILE=
MONGODB_URI=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
TIGER_DATABASE_URL=
# Stable secret needed for repeatable pseudonyms across process restarts.
TELEMETRY_HMAC_KEY=

# Investigation planner owner: openai | foundry | scripted. Unset resolves from the credentials
# below and labels the result in /api/bootstrap (services.plannerDetail). An explicit provider
# with missing credentials reports "unavailable" and stops investigations with
# stopReason=planner_unavailable instead of silently running the scripted planner.
PLANNER_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_ID=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GPTZERO_API_KEY=
GPTZERO_URL=https://api.gptzero.me/v2/predict/text
# Optional account-specific claim-support adapter endpoint. Verify its request contract before enabling.
GPTZERO_CLAIM_SUPPORT_URL=

# --- Release contract v2 policy (backend side). Either a JSON file with {"devices":{keyId:{tenantId,
# deviceId,key}}, "reviewers":{reviewerId:{tenantId,key,caseIds:["*"]}}} or the single-device
# shorthand below (the same six values the gateway exports). Absent => POST /api/intake/v2 returns
# 503 V2_NOT_CONFIGURED and bootstrap reports services.intakeV2=DISABLED.
EDGE_V2_POLICY_FILE=
EDGE_TENANT_ID=
EDGE_DEVICE_ID=
EDGE_SIGNING_KEY_ID=
# >=32 chars each; device and reviewer keys must differ.
EDGE_SIGNING_KEY=
EDGE_REVIEWER_ID=
EDGE_REVIEWER_SIGNING_KEY=
# Comma-separated case IDs the reviewer may associate, or * for the tenant.
EDGE_REVIEWER_CASE_IDS=*

# Python gateway reads environment variables directly; export these in its shell
# (production: infra/edge/lloyd-edge.env.example via systemd EnvironmentFile).
EDGE_BIND_HOST=127.0.0.1
EDGE_BIND_PORT=8001
EDGE_STORAGE_DIR=edge-data
EDGE_RETENTION_SECONDS=86400
EDGE_BACKEND_URL=http://127.0.0.1:3001/api/intake/sanitized
EDGE_BACKEND_V2_URL=http://127.0.0.1:3001/api/intake/v2
EDGE_LOCAL_TOKEN=
# Browser origins allowed to pair directly with the gateway (exact scheme://host:port, comma separated).
EDGE_ALLOWED_ORIGINS=http://localhost:3000
# Separate human approval credential; do not share with automated callers. For v2 either this
# token + EDGE_REVIEWER_ID + EDGE_REVIEWER_SIGNING_KEY, or EDGE_REVIEWERS_FILE=[{"token","id","key"}].
EDGE_HUMAN_APPROVAL_TOKEN=
EDGE_REVIEWERS_FILE=
# Per-device v2 release switch; leave false until the §10 gates pass for this device.
EDGE_V2_ENABLED=false
EDGE_APPROVAL_TTL_SECONDS=600
EDGE_CLOCK_TOLERANCE_SECONDS=30
# Quality thresholds are provisional until calibrated on held-out captures; uncalibrated forces REVIEW.
EDGE_QUALITY_CALIBRATED=false
# Pinned local model artifacts (digests from bundle.manifest.json). Missing/mismatched => capability
# UNAVAILABLE and the v2 pipeline blocks; there is no regex fallback.
EDGE_CLASSIFIER_PATH=
EDGE_CLASSIFIER_SHA256=
EDGE_DETECTOR_PATH=
EDGE_DETECTOR_SHA256=
EDGE_HEALTH_PROBE_CAMERA=true
EDGE_OCR=tesseract
# RDK X5 camera source=camera capture (see gateway/capture.py OpenCVCamera).
# V4L2 device index; a re-plugged or multi-camera board may not stay at 0.
EDGE_CAMERA_INDEX=0
# Frames discarded after opening before the captured frame, since many
# USB/MIPI sensors return a stale or underexposed buffer on first read.
EDGE_CAMERA_WARMUP_FRAMES=2
# Disabled unless both are set. A detector signal can only trigger investigation.
AUTHENTICITY_POLICY_VERSION=
AUTHENTICITY_REVIEW_THRESHOLD=

# Optional local page segmenter (distinct from EDGE_DETECTOR_* NER).
EDGE_PAGE_DETECTOR_PATH=/opt/lloyd-edge/current/models/page-v1_bayese_640x640_nv12.bin
EDGE_PAGE_DETECTOR_SHA256=
EDGE_PAGE_DETECTOR_BACKEND=auto
EDGE_PAGE_SCORE_MIN=0.35
EDGE_PAGE_INPUT=640

# Persistent local text detection + batched recognition (provision models first).
# EDGE_OCR=region
EDGE_OCR_MANIFEST=
EDGE_OCR_MANIFEST_SHA256=
EDGE_OCR_BATCH_SIZE=4
EDGE_OCR_THREADS=4
EDGE_OCR_DETECT_MAX_SIDE=960
