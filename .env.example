# No credentials required for the 56-case offline demo.
HOST=127.0.0.1
PORT=3001
# Required if binding API beyond loopback. Match API_TOKEN on the gateway.
API_TOKEN=
# Paired HMAC key required to accept authenticated low-confidence approvals.
RELEASE_APPROVAL_KEY=

FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=
# JSON mapping matching the discovered schema hash; see README.
FEDERATO_MAPPING_FILE=
MONGODB_URI=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
TIGER_DATABASE_URL=
# Stable secret needed for repeatable pseudonyms across process restarts.
TELEMETRY_HMAC_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GPTZERO_API_KEY=
GPTZERO_URL=https://api.gptzero.me/v2/predict/text
# Optional account-specific claim-support adapter endpoint. Verify its request contract before enabling.
GPTZERO_CLAIM_SUPPORT_URL=

# Python gateway reads environment variables directly; export these in its shell.
EDGE_STORAGE_DIR=edge-data
EDGE_RETENTION_SECONDS=86400
EDGE_BACKEND_URL=http://127.0.0.1:3001/api/intake/sanitized
EDGE_LOCAL_TOKEN=
# Separate human approval credential; do not share with automated callers.
EDGE_HUMAN_APPROVAL_TOKEN=
EDGE_OCR=tesseract
# Disabled unless both are set. A detector signal can only trigger investigation.
AUTHENTICITY_POLICY_VERSION=
AUTHENTICITY_REVIEW_THRESHOLD=
