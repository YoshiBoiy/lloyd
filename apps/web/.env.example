# Live workstation. The browser talks same-origin to Next; the server proxies
# /api/* (except /api/edge/*) to the Lloyd API and injects API_TOKEN.
NEXT_PUBLIC_LLOYD_API_MODE=http

# Optional override if the UI must call the API directly (not recommended;
# the token would then need to be public). Leave unset to use /api on this origin.
# NEXT_PUBLIC_LLOYD_API_URL=http://127.0.0.1:3001

# Secure intake source when talking to a real gateway.
NEXT_PUBLIC_INTAKE_SOURCE=camera

# Server-only proxy targets. Next also reads API_TOKEN from the repo-root .env.
LLOYD_API_URL=http://127.0.0.1:3001
EDGE_GATEWAY_URL=http://127.0.0.1:8001
EDGE_LOCAL_TOKEN=
EDGE_HUMAN_APPROVAL_TOKEN=
